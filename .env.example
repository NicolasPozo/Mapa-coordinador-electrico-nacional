# Copia este archivo como .env y pega tu clave. .env está en .gitignore y .dockerignore.
# La clave se obtiene en https://portal.api.coordinador.cl (plan "Información Pública (SIP)").
CEN_SIP_USER_KEY=

# Opcionales (valores por defecto):
# NODOS_ACTUALIZAR_CADA_HORAS=6      # 0 = solo al arrancar
# NODOS_DIAS_PRONOSTICO=3
# NODOS_DIAS_DEMANDA_NETA=14
# NODOS_DIAS_CMG=14
# NODOS_DIAS_DEMANDA=7               # demanda real: ~41 peticiones por día, lo más lento
# NODOS_SIN_ACTUALIZAR=0             # 1 = solo servir lo que ya hay en el volumen
# CEN_SIP_MIN_INTERVAL=2.0           # segundos entre peticiones a la API SIP
